PORT=8787
APP_ORIGIN=http://localhost:5173

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OAUTH_STATE_SECRET=

STRIPE_KEY_MODE=dev
STRIPE_SECRET_KEY_DEV=
STRIPE_SECRET_KEY_PROD=
STRIPE_WEBHOOK_SECRET_DEV=
STRIPE_WEBHOOK_SECRET_PROD=
# Sprint 9: signing secret of the separate Stripe event destination for
# Accounts v2 thin events (POST /api/stripe/account-events). See
# docs/support/payments/connect-onboarding.md.
STRIPE_ACCOUNT_EVENTS_WEBHOOK_SECRET_DEV=
STRIPE_ACCOUNT_EVENTS_WEBHOOK_SECRET_PROD=

# Sprint 7 (launch-scope.md section 12): regional sales tax. Leave
# STRIPE_TAX_COLLECTION_COUNTRIES empty until the tax-advice gate is
# cleared -- empty means no tax is calculated or collected anywhere. Once a
# country is listed (comma-separated ISO codes, e.g. GB,IE), all four tax
# codes are required: whether the buyer fee, tip and contribution are
# taxable is an advice question, so there is no default. See
# docs/support/payments/tax.md.
STRIPE_TAX_COLLECTION_COUNTRIES=
STRIPE_TAX_CODE_BASE=
STRIPE_TAX_CODE_BUYER_FEE=
STRIPE_TAX_CODE_TIP=
STRIPE_TAX_CODE_SUPPORT=
# Request header carrying the buyer's IP-geolocated country, e.g.
# cf-ipcountry behind Cloudflare. Empty = no IP evidence is recorded.
TAX_IP_COUNTRY_HEADER=

STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CONNECT_SETUP_URL=
STRIPE_CHECKOUT_RETURN_PATH=

# Sprint 6 (launch-scope.md section 7.1): Cloudflare Email Service,
# authenticated SMTP. Host/port/username are fixed by Cloudflare, not
# per-account -- only EMAIL_SMTP_PASS (a Cloudflare API token scoped to
# Account > Email Sending > Edit) is a real secret. See
# docs/support/messaging/transactional-email.md.
EMAIL_SMTP_HOST=smtp.mx.cloudflare.net
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=api_token
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=notifications@send.madeforstream.com
EMAIL_FROM_NAME=Made for Stream

# Template branding (api/emailTemplates.js). All optional -- blank falls back
# to a plain text wordmark instead of a logo, and no address line. Fill in
# EMAIL_LOGO_URL once a hosted logo image exists. EMAIL_COMPANY_ADDRESS is the
# operator's mailing address, as published in the Terms and Privacy Policy.
# Set to true on a test deployment only: sends French and Spanish email before
# those languages are marked ready (api/emailLanguage.js).
# EMAIL_OFFER_UNFINISHED_LANGUAGES=true

EMAIL_BRAND_NAME=Made for Stream
EMAIL_LOGO_URL=
EMAIL_SUPPORT_EMAIL=support@madeforstream.com
EMAIL_SITE_URL=https://madeforstream.com
EMAIL_COMPANY_ADDRESS=Made for Stream, P.O. Box 34086, Calgary RPO Westbrook, Alberta, Canada T3C 3W2

# Sprint 9: scheduled jobs (docs/support/operations/alerting.md). Cloud
# Scheduler sends "Authorization: Bearer $OPS_CRON_SECRET" (32+ characters;
# unset refuses every call). OPS_ALERT_EMAIL receives the alert digest.
OPS_CRON_SECRET=
OPS_ALERT_EMAIL=ops@madeforstream.com
# Accounts re-read per hourly resync run (1-500).
OPS_RESYNC_BATCH_SIZE=100
# Where alert emails link playbooks.
OPS_PLAYBOOK_BASE_URL=https://github.com/Alvintol/creator-hub/blob/main
