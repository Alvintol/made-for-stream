# Express API (api/server.js). The Vite dev server also proxies /api to it.
VITE_API_BASE=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_BETA_MODE=
VITE_STRIPE_PAYMENTS_ENABLED=
VITE_ADSENSE_ENABLED=
VITE_ADSENSE_CLIENT_ID=

# dev | prod — selects which publishable key is used
VITE_STRIPE_KEY_MODE=
VITE_STRIPE_PUBLISHABLE_KEY_DEV=
VITE_STRIPE_PUBLISHABLE_KEY_PROD=

# "true" offers languages that are not finished yet (French), for the dev
# website only. Leave empty in production: see docs/support/site/languages.md.
VITE_OFFER_UNFINISHED_LANGUAGES=
